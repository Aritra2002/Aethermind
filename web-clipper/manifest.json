{
  "manifest_version": 3,
  "name": "AetherMind Web Clipper",
  "version": "1.1",
  "description": "Clip web pages directly into your local AetherMind Knowledge Graph.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "optional_host_permissions": ["http://localhost/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html"
  }
}