# ============================================================
# .gitignore — AetherMind Repository Ignore Rules
# ============================================================

# python virtual environment
.venv

# Dependencies
node_modules/
.pnp
.pnp.js
jspm_packages/
bower_components/

# Build and Bundler Output
dist/
dist-ssr/
build/
.next/
.nuxt/
.vuepress/dist/
.output/

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Test & Coverage
coverage/
*.lcov
.nyc_output/
test_*.py
eslint*.txt
eslint_report.json

# Cache directories
.cache/
.parcel-cache/
.vite/
.eslintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
*.tsbuildinfo
.npm/

# Environment Variables & Secrets
.env
.env.test
.env*.local
*.local

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI Agents, Brain & Tooling Artifacts
.agent/
.agents/
.gemini/
.claude/
.gstack/
.freebuff/
.tempmediaStorage/
scratch/
mobile_*.png

# Local Embedded Database & RAG caches
*.dbchroma_data/

# QA bot generated outputs (do not commit — regenerated by qa_bot/report.py from results_*.json)
qa_bot/screenshots/
qa_bot/artifacts/
qa_bot/__pycache__/
qa_bot/results_*.json
qa_bot/_failures/
qa_bot/gallery.html
qa_bot/report.md
qa_bot/probe.json
# Throwaway one-off measurement probes (diagnostic, not long-term tooling)
qa_bot/_f2_probe.py
qa_bot/_f3_direct.py
qa_bot/_ai2_full.py
