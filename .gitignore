# ============================================================
# .gitignore — AetherMind Repository Ignore Rules
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js
jspm_packages/
bower_components/

# Build and Bundler Output
dist/
dist-ssr/
build/
.next/
.nuxt/
.vuepress/dist/
.output/

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Test & Coverage
coverage/
*.lcov
.nyc_output/
test_*.py
eslint*.txt
eslint_report.json

# Cache directories
.cache/
.parcel-cache/
.vite/
.eslintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
*.tsbuildinfo
.npm/

# Environment Variables & Secrets
.env
.env.test
.env*.local
*.local

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI Agents, Brain & Tooling Artifacts
.agent/
.agents/
.gemini/
.claude/
.gstack/
.tempmediaStorage/
scratch/
mobile_*.png

# Local Embedded Database & RAG caches
*.db
chroma_data/